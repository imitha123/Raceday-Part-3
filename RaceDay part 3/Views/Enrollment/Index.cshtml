@model IEnumerable<RaceDay_part_3.ViewModels.EnrollmentViewModel>

@{
    ViewData["Title"] = "Enrollments";
    var isOrganizer = Context.Session.GetString("Role") == "Organizer";
}

<div class="container mt-4">

    <h2>Enrollment Management</h2>

    <p class="text-muted">
        View and manage event enrollments.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!isOrganizer)
    {
        <a asp-action="Create" class="btn btn-primary mb-3">
            Enroll in an Event
        </a>
    }

    <table class="table table-striped table-bordered">

        <thead class="table-dark">
            <tr>
                <th>Event ID</th>
                <th>Participant ID</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                @foreach (var enrollment in Model)
                {
                    <tr>
                        <td>@enrollment.EventID</td>
                        <td>@enrollment.ParticipantID</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-eventId="@enrollment.EventID"
                               asp-route-participantId="@enrollment.ParticipantID"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            @if (isOrganizer)
                            {
                                <a asp-action="Edit"
                                   asp-route-eventId="@enrollment.EventID"
                                   asp-route-participantId="@enrollment.ParticipantID"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-eventId="@enrollment.EventID"
                                   asp-route-participantId="@enrollment.ParticipantID"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">
                        No enrollments found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>