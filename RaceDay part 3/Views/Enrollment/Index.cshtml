@model IEnumerable<RaceDay_part_3.ViewModels.EnrollmentViewModel>

@{
    ViewData["Title"] = "Enrollment Management";

    var isOrganizer =
        Context.Session.GetString("Role") == "Organizer";

    var isParticipant =
        Context.Session.GetString("Role") == "Participant";
}

<section class="page-section">

    <div class="page-heading">
        <div>
            <span class="section-eyebrow">RACE OPERATIONS</span>

            <h1>Enrollment Management</h1>

            <p class="text-muted">
                @(isOrganizer
                    ? "Review participant registrations and manage enrollment confirmations."
                    : "View your sporting event registrations and their current status.")
            </p>
        </div>

        @if (isParticipant)
        {
            <a asp-action="Create" class="btn btn-accent">
                + Enroll in an Event
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="card enrollment-card">

        <div class="card-header">
            <h2 class="h5 mb-1">Event Registrations</h2>

            <p class="text-muted mb-0">
                @Model.Count() registration(s) found.
            </p>
        </div>

        <div class="table-responsive">

            <table class="table enrollment-table">

                <thead>
                    <tr>
                        <th scope="col">Event ID</th>
                        <th scope="col">Participant ID</th>
                        <th scope="col">Enrollment Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var enrollment in Model)
                        {
                            var isConfirmed =
                                enrollment.Status?.Equals(
                                    "Confirmed",
                                    StringComparison.OrdinalIgnoreCase
                                ) == true;

                            <tr>

                                <td>
                                    <strong>#@enrollment.EventID</strong>
                                </td>

                                <td>
                                    #@enrollment.ParticipantID
                                </td>

                                <td>
                                    @if (isConfirmed)
                                    {
                                        <span class="status-badge status-confirmed"
                                              aria-label="Enrollment confirmed">
                                            <span aria-hidden="true">●</span>
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending"
                                              aria-label="Enrollment pending">
                                            <span aria-hidden="true">●</span>
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-group">

                                        <a asp-action="Details"
                                           asp-route-eventId="@enrollment.EventID"
                                           asp-route-participantId="@enrollment.ParticipantID"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        @if (isOrganizer)
                                        {
                                            @if (!isConfirmed)
                                            {
                                                <form asp-action="UpdateStatus"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="eventId"
                                                           value="@enrollment.EventID" />

                                                    <input type="hidden"
                                                           name="participantId"
                                                           value="@enrollment.ParticipantID" />

                                                    <input type="hidden"
                                                           name="status"
                                                           value="Confirmed" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Confirm
                                                    </button>

                                                </form>
                                            }

                                            <a asp-action="Edit"
                                               asp-route-eventId="@enrollment.EventID"
                                               asp-route-participantId="@enrollment.ParticipantID"
                                               class="btn btn-outline-secondary btn-sm">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-eventId="@enrollment.EventID"
                                               asp-route-participantId="@enrollment.ParticipantID"
                                               class="btn btn-outline-danger btn-sm">
                                                Delete
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-state">

                                <span class="display-5"
                                      aria-hidden="true">📋</span>

                                <h3 class="h5 mt-3">
                                    No enrollments found
                                </h3>

                                <p class="text-muted">
                                    @(isParticipant
                                        ? "You haven't registered for any events yet."
                                        : "There are currently no participant registrations.")
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>