@model RaceDay_part_3.ViewModels.ResultCreateViewModel

@{
    ViewData["Title"] = "Create Result";
}

<h2>Create Result</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ParticipantID" class="form-label">
                    Participant ID
                </label>

                <input asp-for="ParticipantID" class="form-control" />

                <span asp-validation-for="ParticipantID"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Position" class="form-label">
                    Position
                </label>

                <input asp-for="Position" class="form-control" />

                <span asp-validation-for="Position"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Score" class="form-label">
                    Score
                </label>

                <input asp-for="Score" class="form-control" />

                <span asp-validation-for="Score"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create Result
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}