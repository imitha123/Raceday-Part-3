@model RaceDay_part_3.ViewModels.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Event Details</h4>
                </div>

                <div class="card-body p-4">

                    <dl class="row">

                        <dt class="col-sm-4">Event ID</dt>
                        <dd class="col-sm-8">@Model.ÈventID</dd>

                        <dt class="col-sm-4">Event Name</dt>
                        <dd class="col-sm-8">@Model.EventName</dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@Model.EventLocation</dd>

                        <dt class="col-sm-4">Event Date</dt>
                        <dd class="col-sm-8">@Model.EventDate</dd>

                        <dt class="col-sm-4">Category ID</dt>
                        <dd class="col-sm-8">@Model.CategoryID</dd>

                        <dt class="col-sm-4">Organizer ID</dt>
                        <dd class="col-sm-8">@Model.OrganizerID</dd>

                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Events
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.ÈventID"
                           class="btn btn-warning">
                            Edit Event
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>