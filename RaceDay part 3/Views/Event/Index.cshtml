@model IEnumerable<RaceDay_part_3.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Events";
    var isOrganizer = Context.Session.GetString("Role") == "Organizer";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>@(isOrganizer ? "Event Management" : "Browse Events")</h2>

            <p class="text-muted">
                @(isOrganizer
                    ? "Create and manage sporting events."
                    : "Discover sporting events and find something to participate in.")
            </p>
        </div>

        @if (isOrganizer)
        {
            <a asp-action="Create" class="btn btn-success">
                Create Event
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Available Events</h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Event ID</th>
                                <th>Event Name</th>
                                <th>Location</th>
                                <th>Date</th>
                                <th>Category ID</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.eventId</td>
                                    <td>@item.EventName</td>
                                    <td>@item.EventLocation</td>
                                    <td>@item.EventDate</td>
                                    <td>@item.CategoryID</td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.eventId"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        @if (isOrganizer)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.eventId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.eventId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this event?');">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>No Events Found</h5>

                    <p class="text-muted">
                        @(isOrganizer
                            ? "You haven't created any events yet."
                            : "There are currently no events available.")
                    </p>

                    @if (isOrganizer)
                    {
                        <a asp-action="Create" class="btn btn-primary">
                            Create Your First Event
                        </a>
                    }

                </div>
            }

        </div>

    </div>

    @if (isOrganizer)
    {
        <a asp-controller="Organizer"
           asp-action="Dashboard"
           class="btn btn-outline-secondary mt-4">
            Back to Dashboard
        </a>
    }
    else
    {
        <a asp-controller="Participant"
           asp-action="Dashboard"
           class="btn btn-outline-secondary mt-4">
            Back to Dashboard
        </a>
    }

</div>