@model RaceDay_part_3.ViewModels.ParticipantRegisterViewModel

@{
    ViewData["Title"] = "Participant Registration";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-10 col-xl-9">

                <div class="auth-card">

                    <div class="row g-0">

                        <div class="col-md-5 auth-banner d-flex flex-column justify-content-center">

                            <span class="hero-label">
                                JOIN THE MOVEMENT
                            </span>

                            <h2>
                                YOUR STORY
                                <span class="accent">STARTS NOW.</span>
                            </h2>

                            <p class="mt-3">
                                Sign up, find your next event
                                and get ready to compete.
                            </p>

                        </div>

                        <div class="col-md-7 auth-form">

                            <h2>Join RaceDay</h2>

                            <p class="text-muted mb-4">
                                Create your participant account.
                            </p>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger raceday-alert"
                                     role="alert">
                                    @ViewBag.Error
                                </div>
                            }

                            <form asp-action="Register" method="post">

                                @Html.AntiForgeryToken()

                                <div asp-validation-summary="ModelOnly"
                                     class="validation-summary-errors mb-3">
                                </div>

                                <div class="mb-3">

                                    <label asp-for="ParticipantName"
                                           class="form-label">
                                        First Name
                                    </label>

                                    <input asp-for="ParticipantName"
                                           class="form-control"
                                           placeholder="Enter your first name"
                                           autocomplete="given-name" />

                                    <span asp-validation-for="ParticipantName"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="ParticipantSurname"
                                           class="form-label">
                                        Surname
                                    </label>

                                    <input asp-for="ParticipantSurname"
                                           class="form-control"
                                           placeholder="Enter your surname"
                                           autocomplete="family-name" />

                                    <span asp-validation-for="ParticipantSurname"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="Email"
                                           class="form-label">
                                        Email Address
                                    </label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="you@example.com"
                                           autocomplete="email" />

                                    <span asp-validation-for="Email"></span>

                                </div>

                                <div class="mb-4">

                                    <label asp-for="Password"
                                           class="form-label">
                                        Password
                                    </label>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Create a password"
                                           autocomplete="new-password" />

                                    <span asp-validation-for="Password"></span>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    Create Participant Account
                                </button>

                            </form>

                            <div class="text-center mt-4">

                                <p class="text-muted mb-0">
                                    Already have an account?
                                    <a asp-action="Login"
                                       class="fw-bold">
                                        Sign in
                                    </a>
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}