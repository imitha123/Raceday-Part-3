@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1>Participant Dashboard</h1>

        <h4>Welcome, @Context.Session.GetString("UserName")!</h4>

        <p>
            Welcome to RaceDay!
            Discover events, manage your registrations
            and keep track of your results.
        </p>

        <hr />

        <h5>Participant Menu</h5>

        <div class="row mt-4">

            <div class="col-md-4 mb-3">
                <div class="card p-3">
                    <h5>Browse Events</h5>
                    <p>Discover available events.</p>
                    <a href="#" class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card p-3">
                    <h5>My Registrations</h5>
                    <p>View your registered events.</p>
                    <a href="#" class="btn btn-primary">
                        My Registrations
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card p-3">
                    <h5>My Results</h5>
                    <p>Track your event results.</p>
                    <a href="#" class="btn btn-primary">
                        My Results
                    </a>
                </div>
            </div>

        </div>

        <form asp-controller="Organizer"
              asp-action="Logout"
              method="post">

            <button type="submit" class="btn btn-danger">
                Logout
            </button>

        </form>

    </div>

</div>