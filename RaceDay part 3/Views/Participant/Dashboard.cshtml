@{
    ViewData["Title"] = "Participant Dashboard";

    var userName = Context.Session.GetString("UserName");
}

<section class="dashboard-page">

    <div class="dashboard-welcome card p-4 mb-4">

        <div class="row align-items-center">

            <div class="col-md-8">

                <span class="badge bg-primary mb-2">
                    PARTICIPANT PORTAL
                </span>

                <h1>Welcome, @userName!</h1>

                <p class="mb-0">
                    Your RaceDay journey starts here.
                    Discover sporting events, manage your registrations
                    and follow your performance.
                </p>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <span class="display-3"
                      aria-hidden="true">
                    🏃
                </span>

            </div>

        </div>

    </div>


    <div class="mb-4">

        <h2>Your Participant Dashboard</h2>

        <p class="text-muted">
            Select an option below to manage your sporting activities.
        </p>

    </div>


    <div class="row g-4">

        <!-- BROWSE EVENTS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        🏁
                    </span>

                    <h3 class="card-title h5">
                        Browse Events
                    </h3>

                    <p class="card-text">
                        Explore available sporting events
                        and find your next challenge.
                    </p>

                    <a asp-controller="Event"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">

                        Explore Events

                    </a>

                </div>

            </div>

        </div>


        <!-- MY REGISTRATIONS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        📋
                    </span>

                    <h3 class="card-title h5">
                        My Registrations
                    </h3>

                    <p class="card-text">
                        View your event registrations
                        and keep track of your participation.
                    </p>

                    <a asp-controller="Enrollment"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">

                        View Registrations

                    </a>

                </div>

            </div>

        </div>


        <!-- MY RESULTS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        🏆
                    </span>

                    <h3 class="card-title h5">
                        My Results
                    </h3>

                    <p class="card-text">
                        Track your results and review
                        your performance in completed events.
                    </p>

                    <a asp-controller="Result"
                       asp-action="Index"
                       class="btn btn-accent mt-auto">

                        View My Results

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>