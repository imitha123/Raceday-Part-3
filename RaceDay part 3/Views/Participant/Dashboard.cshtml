@{
    ViewData["Title"] = "Participant Dashboard";
    var userName = Context.Session.GetString("UserName");
}

<section class="dashboard-page">

    <!-- WELCOME HERO -->
    <div class="dashboard-hero participant-hero">
        <div class="dashboard-hero-content">
            <span class="dashboard-eyebrow">
                <span class="eyebrow-dot"></span>
                PARTICIPANT PORTAL
            </span>

            <h1>Ready to make<br />your <span>next move?</span></h1>

            <p>
                Welcome back, @(string.IsNullOrWhiteSpace(userName) ? "Athlete" : userName).
                Discover competitions, manage your registrations and
                keep track of your racing journey.
            </p>

            <div class="dashboard-hero-actions">
                <a asp-controller="Event"
                   asp-action="Index"
                   class="btn btn-dashboard-primary">
                    Explore Events <span aria-hidden="true">→</span>
                </a>

                <a asp-controller="Enrollment"
                   asp-action="Index"
                   class="btn btn-dashboard-secondary">
                    My Registrations
                </a>
            </div>
        </div>

        <div class="dashboard-hero-visual" aria-hidden="true">
            <div class="hero-visual-circle">
                <span>🏃</span>
            </div>
            <div class="hero-visual-label">YOUR RACE. YOUR JOURNEY.</div>
        </div>

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>
    </div>

    <!-- SECTION HEADING -->
    <div class="dashboard-section-heading">
        <div>
            <span class="section-kicker">YOUR SPACE</span>
            <h2>Participant Hub</h2>
            <p>Everything you need to stay connected to your sporting journey.</p>
        </div>
    </div>

    <!-- DASHBOARD CARDS -->
    <div class="row g-4">

        <!-- BROWSE EVENTS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon orange-icon" aria-hidden="true">
                        🏁
                    </div>
                    <span class="feature-number">01</span>
                </div>

                <h3>Discover Events</h3>

                <p>
                    Find your next challenge. Explore available sporting
                    events and discover competitions you can participate in.
                </p>

                <a asp-controller="Event"
                   asp-action="Index"
                   class="feature-link">
                    Explore events <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- REGISTRATIONS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon blue-icon" aria-hidden="true">
                        📋
                    </div>
                    <span class="feature-number">02</span>
                </div>

                <h3>My Registrations</h3>

                <p>
                    Keep track of the events you've enrolled in and
                    check the status of your registrations.
                </p>

                <a asp-controller="Enrollment"
                   asp-action="Index"
                   class="feature-link">
                    View registrations <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- RESULTS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon green-icon" aria-hidden="true">
                        🏆
                    </div>
                    <span class="feature-number">03</span>
                </div>

                <h3>My Results</h3>

                <p>
                    Review your competition results and follow
                    your performance across completed sporting events.
                </p>

                <a asp-controller="Result"
                   asp-action="Index"
                   class="feature-link">
                    View my results <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

    </div>

    <!-- BOTTOM BANNER -->
    <div class="dashboard-bottom-banner">
        <div>
            <span class="section-kicker">THE FINISH LINE IS JUST THE BEGINNING</span>
            <h3>Every race tells a story.</h3>
            <p>Stay active, challenge yourself and make every competition count.</p>
        </div>

        <span class="bottom-banner-icon" aria-hidden="true">🏅</span>
    </div>

</section>