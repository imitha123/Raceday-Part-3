@{
    ViewData["Title"] = "Organizer Dashboard";
    var userName = Context.Session.GetString("UserName");
}

<section class="dashboard-page">

    <!-- WELCOME HERO -->
    <div class="dashboard-hero organizer-hero">
        <div class="dashboard-hero-content">
            <span class="dashboard-eyebrow">
                <span class="eyebrow-dot"></span>
                ORGANIZER CONTROL CENTRE
            </span>

            <h1>Let's make<br />every event <span>count.</span></h1>

            <p>
                Welcome back, @(string.IsNullOrWhiteSpace(userName) ? "Organizer" : userName).
                Manage sporting events, oversee registrations and
                keep your competitions running smoothly.
            </p>

            <div class="dashboard-hero-actions">
                <a asp-controller="Event"
                   asp-action="Index"
                   class="btn btn-dashboard-primary">
                    Manage Events <span aria-hidden="true">→</span>
                </a>

                <a asp-controller="Enrollment"
                   asp-action="Index"
                   class="btn btn-dashboard-secondary">
                    View Enrollments
                </a>
            </div>
        </div>

        <div class="dashboard-hero-visual" aria-hidden="true">
            <div class="hero-visual-circle">
                <span>🏆</span>
            </div>
            <div class="hero-visual-label">PLAN. ORGANIZE. DELIVER.</div>
        </div>

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>
    </div>

    <!-- SECTION HEADING -->
    <div class="dashboard-section-heading">
        <div>
            <span class="section-kicker">MANAGEMENT CENTRE</span>
            <h2>Your Operations</h2>
            <p>Access the tools you need to manage the RaceDay platform.</p>
        </div>
    </div>

    <!-- MANAGEMENT CARDS -->
    <div class="row g-4">

        <!-- EVENTS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon orange-icon" aria-hidden="true">
                        🏁
                    </div>
                    <span class="feature-number">01</span>
                </div>

                <h3>Event Management</h3>

                <p>
                    Create new sporting events, update existing
                    competitions and manage event information.
                </p>

                <a asp-controller="Event"
                   asp-action="Index"
                   class="feature-link">
                    Manage events <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- CATEGORIES -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon blue-icon" aria-hidden="true">
                        📂
                    </div>
                    <span class="feature-number">02</span>
                </div>

                <h3>Category Management</h3>

                <p>
                    Organize sporting categories and maintain
                    classifications for your events.
                </p>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="feature-link">
                    Manage categories <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- RESULTS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon green-icon" aria-hidden="true">
                        🥇
                    </div>
                    <span class="feature-number">03</span>
                </div>

                <h3>Results Management</h3>

                <p>
                    Record participant performances and manage
                    competition results.
                </p>

                <a asp-controller="Result"
                   asp-action="Index"
                   class="feature-link">
                    Manage results <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- ENROLLMENTS -->
        <div class="col-lg-4 col-md-6">
            <div class="dashboard-feature-card h-100">
                <div class="feature-card-top">
                    <div class="feature-icon purple-icon" aria-hidden="true">
                        📋
                    </div>
                    <span class="feature-number">04</span>
                </div>

                <h3>Enrollment Management</h3>

                <p>
                    Review participant registrations and
                    manage enrollment confirmation statuses.
                </p>

                <a asp-controller="Enrollment"
                   asp-action="Index"
                   class="feature-link">
                    Manage enrollments <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

    </div>

    <!-- BOTTOM BANNER -->
    <div class="dashboard-bottom-banner">
        <div>
            <span class="section-kicker">RACEDAY OPERATIONS</span>
            <h3>Great events start with great organization.</h3>
            <p>Keep your competitions organized and your participants informed.</p>
        </div>

        <span class="bottom-banner-icon" aria-hidden="true">🏆</span>
    </div>

</section>