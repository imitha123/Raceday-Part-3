@{
    ViewData["Title"] = "Organizer Dashboard";

    var userName = Context.Session.GetString("UserName");
}

<section class="dashboard-page">

    <div class="dashboard-welcome card p-4 mb-4">

        <div class="row align-items-center">

            <div class="col-md-8">

                <span class="badge bg-primary mb-2">
                    ORGANIZER PORTAL
                </span>

                <h1>Welcome, @userName!</h1>

                <p class="mb-0">
                    Manage your sporting events,
                    organize participants and monitor competition results.
                </p>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <span class="display-3"
                      aria-hidden="true">
                    🏆
                </span>

            </div>

        </div>

    </div>


    <div class="mb-4">

        <h2>Organizer Dashboard</h2>

        <p class="text-muted">
            Manage your RaceDay platform activities from one place.
        </p>

    </div>


    <div class="row g-4">

        <!-- MANAGE EVENTS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        🏁
                    </span>

                    <h3 class="card-title h5">
                        Manage Events
                    </h3>

                    <p class="card-text">
                        Create new sporting events,
                        update existing events and manage event details.
                    </p>

                    <a asp-controller="Event"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">

                        Manage Events

                    </a>

                </div>

            </div>

        </div>


        <!-- MANAGE CATEGORIES -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        📂
                    </span>

                    <h3 class="card-title h5">
                        Manage Categories
                    </h3>

                    <p class="card-text">
                        Organize sporting event categories
                        and maintain your event classifications.
                    </p>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">

                        Manage Categories

                    </a>

                </div>

            </div>

        </div>


        <!-- MANAGE RESULTS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        🥇
                    </span>

                    <h3 class="card-title h5">
                        Manage Results
                    </h3>

                    <p class="card-text">
                        Create, update and manage participant
                        results for sporting events.
                    </p>

                    <a asp-controller="Result"
                       asp-action="Index"
                       class="btn btn-accent mt-auto">

                        Manage Results

                    </a>

                </div>

            </div>

        </div>


        <!-- MANAGE ENROLLMENTS -->

        <div class="col-lg-4 col-md-6">

            <div class="card dashboard-card h-100 p-3">

                <div class="card-body d-flex flex-column">

                    <span class="display-5 mb-3"
                          aria-hidden="true">
                        📋
                    </span>

                    <h3 class="card-title h5">
                        Manage Enrollments
                    </h3>

                    <p class="card-text">
                        Review participant registrations
                        and manage event enrollments.
                    </p>

                    <a asp-controller="Enrollment"
                       asp-action="Index"
                       class="btn btn-primary mt-auto">

                        Manage Enrollments

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>