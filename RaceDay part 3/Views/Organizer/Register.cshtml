@model RaceDay_part_3.ViewModels.OrganizerRegisterViewModel

@{
    ViewData["Title"] = "Organizer Registration";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-10 col-xl-9">

                <div class="auth-card">

                    <div class="row g-0">

                        <div class="col-md-5 auth-banner d-flex flex-column justify-content-center">

                            <span class="hero-label">
                                BUILD YOUR EVENT
                            </span>

                            <h2>
                                MAKE EVERY
                                <span class="accent">RACE</span>
                                COUNT.
                            </h2>

                            <p class="mt-3">
                                Create your organizer account
                                and start managing sporting events.
                            </p>

                        </div>

                        <div class="col-md-7 auth-form">

                            <h2>Create Account</h2>

                            <p class="text-muted mb-4">
                                Register as a RaceDay organizer.
                            </p>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger raceday-alert"
                                     role="alert">
                                    @ViewBag.Error
                                </div>
                            }

                            <form asp-action="Register" method="post">

                                @Html.AntiForgeryToken()

                                <div asp-validation-summary="ModelOnly"
                                     class="validation-summary-errors mb-3">
                                </div>

                                <div class="mb-3">

                                    <label asp-for="OrganizerName"
                                           class="form-label">
                                        First Name
                                    </label>

                                    <input asp-for="OrganizerName"
                                           class="form-control"
                                           placeholder="Enter your first name"
                                           autocomplete="given-name" />

                                    <span asp-validation-for="OrganizerName"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="OrganizerSurname"
                                           class="form-label">
                                        Surname
                                    </label>

                                    <input asp-for="OrganizerSurname"
                                           class="form-control"
                                           placeholder="Enter your surname"
                                           autocomplete="family-name" />

                                    <span asp-validation-for="OrganizerSurname"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="OrganizerEmail"
                                           class="form-label">
                                        Email Address
                                    </label>

                                    <input asp-for="OrganizerEmail"
                                           class="form-control"
                                           placeholder="you@example.com"
                                           autocomplete="email" />

                                    <span asp-validation-for="OrganizerEmail"></span>

                                </div>

                                <div class="mb-4">

                                    <label asp-for="Password"
                                           class="form-label">
                                        Password
                                    </label>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Create a password"
                                           autocomplete="new-password" />

                                    <span asp-validation-for="Password"></span>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    Create Organizer Account
                                </button>

                            </form>

                            <div class="text-center mt-4">

                                <p class="text-muted mb-0">
                                    Already registered?
                                    <a asp-action="Login"
                                       class="fw-bold">
                                        Sign in
                                    </a>
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}