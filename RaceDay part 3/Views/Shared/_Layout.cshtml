@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
    var userName = Context.Session.GetString("UserName");

    var isOrganizer = role == "Organizer";
    var isParticipant = role == "Participant";
    var isLoggedIn = isOrganizer || isParticipant;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <a class="skip-link" href="#main-content">
        Skip to main content
    </a>

    <header>
        <nav class="navbar navbar-expand-lg raced ay-navbar">
            <div class="container">

                <a class="navbar-brand raced ay-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">R</span>

                    <span>
                        RACE<span class="brand-highlight">DAY</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    @if (isOrganizer)
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Event"
                                   asp-action="Index">
                                    Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Category"
                                   asp-action="Index">
                                    Categories
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Result"
                                   asp-action="Index">
                                    Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrollment"
                                   asp-action="Index">
                                    Enrollments
                                </a>
                            </li>

                            <li class="nav-item ms-lg-3">
                                <form asp-controller="Organizer"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-nav-logout">
                                        Logout
                                    </button>
                                </form>
                            </li>

                        </ul>
                    }
                    else if (isParticipant)
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Event"
                                   asp-action="Index">
                                    Discover Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrollment"
                                   asp-action="Index">
                                    My Registrations
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Result"
                                   asp-action="Index">
                                    My Results
                                </a>
                            </li>

                            <li class="nav-item ms-lg-3">
                                <form asp-controller="Participant"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-nav-logout">
                                        Logout
                                    </button>
                                </form>
                            </li>

                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-nav-primary"
                                   asp-controller="Participant"
                                   asp-action="Login">
                                    Get Started
                                </a>
                            </li>

                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="main-content">

        <div class="container">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success raced ay-alert"
                     role="alert">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger raced ay-alert"
                     role="alert">
                    @TempData["Error"]
                </div>
            }

        </div>

        @RenderBody()

    </main>

    <footer class="raced ay-footer">
        <div class="container">

            <div class="footer-content">

                <div>
                    <h4>RACE<span>DAY</span></h4>
                    <p>Every event has a starting line.</p>
                </div>

                <div class="footer-right">
                    &copy; @DateTime.Now.Year RaceDay.
                    Built for the thrill of competition.
                </div>

            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>