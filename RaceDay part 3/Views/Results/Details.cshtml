@model RaceDay_part_3.ViewModels.ResultViewModel

@{
    ViewData["Title"] = "Result Details";
    var isOrganizer = Context.Session.GetString("Role") == "Organizer";
}

<h2>Result Details</h2>

<div class="card">
    <div class="card-body">

        <p><strong>Result ID:</strong> @Model.ResultID</p>

        <p><strong>Participant ID:</strong> @Model.ParticipantID</p>

        <p><strong>Position:</strong> @Model.Position</p>

        <p><strong>Score:</strong> @Model.Score</p>

        @if (isOrganizer)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.ResultID"
               class="btn btn-warning">
                Edit Result
            </a>
        }

        <a asp-action="Index" class="btn btn-secondary">
            Back to Results
        </a>

    </div>
</div>