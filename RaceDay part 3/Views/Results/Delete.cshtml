@model RaceDay_part_3.ViewModels.ResultViewModel

@{
    ViewData["Title"] = "Delete Result";
}

<h2>Delete Result</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this result?
    This action cannot be undone.
</div>

<div class="card">
    <div class="card-body">

        <p><strong>Result ID:</strong> @Model.ResultID</p>

        <p><strong>Participant ID:</strong> @Model.ParticipantID</p>

        <p><strong>Position:</strong> @Model.Position</p>

        <p><strong>Score:</strong> @Model.Score</p>

        <form asp-action="Delete"
              asp-route-id="@Model.ResultID"
              method="post">

            <button type="submit" class="btn btn-danger">
                Confirm Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>